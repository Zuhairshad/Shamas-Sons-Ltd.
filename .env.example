# Shopify Storefront API credentials.
#
# Copy this file and fill in real values:
#   local dev  ->  cp .env.example .env.local
#   server     ->  cp .env.example .env.production
#
# Both files are gitignored. Leave these unset (or delete the file) to run the
# app on the built-in mock catalog in lib/shopify/client.ts.
#
# Note: NEXT_PUBLIC_* values are inlined into the client bundle at build time,
# so changing them on the server requires a re-deploy, not just a pm2 restart.
# The storefront token is public by design — never put an Admin API token here.

# Your store's myshopify domain, no https:// and no trailing slash.
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com

# Shopify admin -> Settings -> Apps and sales channels -> Develop apps
# -> your app -> API credentials -> Storefront API access token.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
